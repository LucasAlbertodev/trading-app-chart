{
  "name": "albertoscharts",
  "version": "1.1.1",
  "description": "AlbertosCharts: gráficos estilo TradingView con CFD en tiempo real (Capital.com), backtesting con estadísticas y aceleración por GPU (Metal / Direct3D 11 / Vulkan). Basado en Wickline (MIT).",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "update-data": "node scripts/update-data.mjs",
    "update-vendor": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/lightweight-charts/dist/lightweight-charts.standalone.production.mjs','public/vendor/lightweight-charts.mjs');fs.copyFileSync('node_modules/lightweight-charts/LICENSE','public/vendor/LICENSE-lightweight-charts.txt')\"",
    "test": "node test/backtest.test.mjs && node test/strategy-worker.test.mjs && node test/clean-bars.test.mjs && node test/indicators.test.mjs && node test/data.test.mjs && node test/screener.test.mjs && node test/news.test.mjs && node test/paper.test.mjs && node test/heatmap.test.mjs && node test/heatmap-markets.test.mjs && node test/options.test.mjs && node test/layout.test.mjs && node test/script-sanitize.test.mjs && node test/update.test.mjs && node test/server.test.mjs && node test/timeframes.test.mjs && node test/proxy.test.mjs && node test/i18n.test.mjs && node test/watchlist.test.mjs && node test/brokers.test.mjs && node test/journal.test.mjs && node test/community.test.mjs",
    "test:e2e": "electron test/e2e.mjs",
    "dist:mac-intel": "electron-builder --mac --x64 --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "charts",
    "trading",
    "candlestick",
    "crypto",
    "stocks",
    "technical-analysis"
  ],
  "dependencies": {
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "lightweight-charts": "^5.3.0"
  },
  "author": "Wickline contributors",
  "build": {
    "appId": "com.lucasalberto.albertoscharts",
    "productName": "AlbertosCharts",
    "copyright": "AlbertosCharts · basado en Wickline (MIT)",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.mjs",
      "lib/**",
      "community/**",
      "public/**",
      "desktop/**",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Windows-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Windows-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-Intel-Mac-${version}.${ext}",
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "LucasAlberto",
      "icon": "build/icon.png",
      "artifactName": "${productName}-Linux-${version}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasAlbertodev/trading-app-chart.git"
  }
}
